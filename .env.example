# =====================================================================
# AI-Powered Web API Security Gateway - Environment Configuration
# =====================================================================
# Copy this file to .env before starting services in production or docker.
# Do not commit credentials or sensitive API keys to source control.

# Gateway Service Configuration (Spring Boot)
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
SERVER_SERVLET_CONTEXT_PATH=/

# Database Configuration (MongoDB)
# Default is local MongoDB; if unavailable, Gateway falls back to in-memory event buffer.
MONGODB_URI=mongodb://localhost:27017/security_gateway
MONGODB_DATABASE=security_gateway

# Machine Learning Service Configuration (FastAPI)
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=1500

# Decision Engine Risk Thresholds (0 - 100)
# 0 to RISK_LOW_MAX       => ALLOW (Low Risk)
# RISK_LOW_MAX+1 to RISK_MEDIUM_MAX => FLAG  (Medium Risk)
# > RISK_MEDIUM_MAX       => BLOCK (High Risk)
RISK_LOW_MAX=29
RISK_MEDIUM_MAX=69

# Security and Proxy Constraints
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_PER_MINUTE=60
DEMO_UPSTREAM_URL=http://localhost:8080/api/v1/demo/upstream

# Frontend Configuration (Vite)
VITE_GATEWAY_API_URL=http://localhost:8080/api/v1
VITE_APP_ENV=LOCAL_DEMO
